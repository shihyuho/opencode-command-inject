{
  "name": "opencode-command-inject",
  "version": "1.3.1",
  "description": "Auto-inject project commands into OpenCode. Finds Makefile targets, package.json scripts, and discovered local skills at startup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shihyuho/opencode-command-inject"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "commands",
    "makefile",
    "npm-scripts"
  ],
  "bugs": {
    "url": "https://github.com/shihyuho/opencode-command-inject/issues"
  },
  "homepage": "https://github.com/shihyuho/opencode-command-inject#readme",
  "files": [
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "opencode-command-inject.schema.json"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate-schema": "bun run scripts/generate-schema.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@opencode-ai/sdk": "^1.2.15",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "3.24.1"
  }
}